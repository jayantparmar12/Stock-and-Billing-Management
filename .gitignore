frontend/.env
frontend/.env.*
!frontend/.env.example

# ==========================================
# BACKEND - Maven / Spring Boot
# ==========================================
backend/target/

# Maven wrapper: keep these tracked
# mvnw
# mvnw.cmd
# .mvn/wrapper/maven-wrapper.properties
# .mvn/wrapper/maven-wrapper.jar

